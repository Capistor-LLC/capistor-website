{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capistor-production",
  "main": "workers/index.mjs",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/portal*",
      "/admin*",
      "/login*",
      "/checkout*",
      "/products",
      "/capabilities",
      "/blog"
    ]
  },
  "vars": {
    "DEPLOYMENT_ENV": "production",
    "STRIPE_MODE": "live",
    "APP_ORIGIN": "https://capistor-production.capistor-website.workers.dev",
    "NOTIFICATION_FROM": "Capistor Technologies <support@capistortechnologies.com>",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1UeuQWLFAmiFFgyn84W6GiMf"
  }
}
