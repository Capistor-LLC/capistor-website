{
  "name": "capistor-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .local/ssr && node scripts/prerender.mjs",
    "sitemap": "node scripts/prerender.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "dev:api": "node --env-file=.env.local --import tsx server/dev.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run tests",
    "check:setup": "node scripts/check-setup.mjs",
    "seed:commerce": "node --env-file=.env.local --import tsx scripts/seed-commerce.ts",
    "lint:commerce": "eslint server src/commerce api tests --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@formspree/react": "^3.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "@uiw/react-md-editor": "^4.1.0",
    "framer-motion": "^12.23.11",
    "gsap": "^3.13.0",
    "katex": "^0.19.1",
    "lenis": "^1.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.5.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.7.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^8.57.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.6.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.15.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "katex": "$katex",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
