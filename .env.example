# Browser-safe Supabase configuration. Use a separate project for staging where possible.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Optional, production only. Existing Capistor GA4 measurement ID: G-R7RH1P15MH
VITE_GA_MEASUREMENT_ID=
# Set true only after disabling Enhanced Measurement in the GA4 web stream.
VITE_GA_MANUAL_ONLY=false

# Server only — NEVER prefix these with VITE_. Do not commit .env.local.
APP_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SECRET_OR_SERVICE_ROLE_KEY
STRIPE_MODE=test
VITE_PAYMENT_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Hosted Checkout does not need a publishable key in the browser.
# Switch both modes to live only together with live keys and a live webhook.
# Test mode disables real bank/Bitcoin payments. Vercel Production rejects test charges;
# Vercel Preview rejects live charges. Preview APP_ORIGIN can be omitted to use its branch URL.

# Cloudflare R2: private bucket, R2.dev and public custom domains disabled.
R2_ACCOUNT_ID=
R2_BUCKET=capistor-private-staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# JSON object in a single-quoted dotenv value. Real bank details belong here privately.
BANK_DETAILS_JSON='{"account_holder":"YOUR LEGAL BUSINESS NAME","iban":"YOUR_IBAN","bic":"YOUR_BIC","bank_address":"YOUR_BANK_ADDRESS"}'

# Optional Bitcoin. Keep disabled until all four values and webhook tests are complete.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Optional Vercel deploy hook, for rebuilding public HTML after catalogue/editorial updates.
VERCEL_DEPLOY_HOOK=
